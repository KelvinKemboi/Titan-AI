    {
      "type": "stat",
      "title": "Hours since last good scan",
      "description": "From Postgres - covers scans from Streamlit and the scheduler alike.",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "titan-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(completed_at))/3600 AS hours FROM scan_runs WHERE status IN ('complete','partial')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "titan-postgres"
          }
        }
      ]
    },
