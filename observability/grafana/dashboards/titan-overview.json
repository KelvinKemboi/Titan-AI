    {
      "type": "timeseries",
      "title": "Daily LLM spend (all processes, from llm_calls)",
      "description": "",
      "id": 21,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "titan-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
