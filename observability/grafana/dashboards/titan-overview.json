        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('day', created_at) AS time, call_type, sum(cost_usd)::float AS spend FROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1,2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
