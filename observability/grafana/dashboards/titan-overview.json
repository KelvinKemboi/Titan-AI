        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT started_at AS time, EXTRACT(EPOCH FROM completed_at-started_at)::float AS duration_s FROM scan_runs WHERE completed_at IS NOT NULL AND $__timeFilter(started_at) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "titan-postgres"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ticker coverage per scan",
      "description": "Share of the universe successfully scored - drops reveal yfinance throttling/outages.",
      "id": 24,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "titan-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT s.started_at AS time, count(f.id)::float / NULLIF(s.universe_size,0) AS coverage FROM scan_runs s LEFT JOIN factor_scores f ON f.scan_run_id=s.id WHERE $__timeFilter(s.started_at) GROUP BY s.id ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "titan-postgres"
          }
        }
      ]
    },
