    {
      "type": "timeseries",
      "title": "Scan duration (s)",
      "description": "",
      "id": 23,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "titan-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
